GEMINI_API_KEY = "your-gemini-api-key-here"
GMAIL_ADDRESS = "your-gmail-address-here"
GMAIL_APP_PASSWORD = "your-16-char-app-password-here"

# Optional: model to use (default gemini-3.5-flash)
GEMINI_MODEL = "gemini-3.5-flash"
# "true" shows the optional Authority email field. Keep "false" on a public app.
ALLOW_AUTHORITY_EMAIL = "false"